{
  "name": "loomlog",
  "version": "0.4.0",
  "description": "Local, cross-agent dev journal for Claude Code, Codex & Gemini CLI — passively weaves your AI coding sessions into an Obsidian-compatible vault.",
  "type": "module",
  "bin": {
    "loomlog": "dist/cli.js"
  },
  "files": [
    "dist",
    "integrations"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --clean",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "claude-code",
    "codex",
    "gemini-cli",
    "obsidian",
    "daily-report",
    "journal",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Gaku1031",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaku1031/loomlog.git"
  },
  "homepage": "https://github.com/Gaku1031/loomlog#readme",
  "bugs": "https://github.com/Gaku1031/loomlog/issues",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
