{
  "name": "loomlog",
  "version": "0.0.1",
  "description": "Local, cross-agent dev journal for Claude Code, Codex & Gemini CLI — passively weaves your AI coding sessions into an Obsidian-compatible vault.",
  "type": "module",
  "bin": {
    "loomlog": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --clean",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude-code",
    "codex",
    "gemini-cli",
    "obsidian",
    "daily-report",
    "journal",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
